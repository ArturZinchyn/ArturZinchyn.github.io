<!DOCTYPE html>
<html>
<head>
    <title>Edit Gun <%= item.name %> (<%= item.id %>)</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body>
    <nav>
        <ul>
            <li><a href="/">HOME</a></li>
            <li><a href="/guns">GUNS</a></li>
        </ul>
    </nav>

    <main class="edit">
        <h1>Edit Gun <%= item.name %> (<%= item.id %>)</h1>

        <form action="/guns/<%= item.id %>/edit" method="POST" class="edit-form">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" value="<%= item.name %>" required>
            </div>
            <div class="form-group">
                <label for="caliber">Caliber</label>
                <input type="text" id="caliber" name="caliber" value="<%= item.caliber %>" required>
            </div>
            <div class="form-group">
                <label for="magazine_capacity">Magazine Capacity</label>
                <input type="text" id="magazine_capacity" name="magazine_capacity" value="<%= item.magazine_capacity %>" required>
            </div>

            <button type="submit">Submit</button>
        </form>

        <br>
        <ul class="action-list">
            <li><a href="/guns">Back to list</a></li>
            <li>
                <form action="/guns/<%= item.id %>/delete" method="POST" style="display:inline;">
                    <button type="submit">Delete</button>
                </form>
            </li>
        </ul>
    </main>
</body>
</html>