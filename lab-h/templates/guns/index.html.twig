{% extends 'base.html.twig' %}

{% block title %}Lista broni{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Lista broni</h1>
        <a href="{{ path('app_guns_new') }}" class="btn btn-danger shadow-sm">Dodaj nową</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered shadow-sm bg-white">
            <thead class="table-danger">
            <tr>
                <th>Id</th>
                <th>Nazwa</th>
                <th>Kaliber</th>
                <th>Pojemność magazynka</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            {% for gun in guns %}
                <tr>
                    <td>{{ gun.id }}</td>
                    <td>{{ gun.name }}</td>
                    <td>{{ gun.caliber }}</td>
                    <td>{{ gun.magazineCapacity }}</td>
                    <td>
                        <a href="{{ path('app_guns_show', {'id': gun.id}) }}" class="btn btn-sm btn-outline-danger">Pokaż</a>
                        <a href="{{ path('app_guns_edit', {'id': gun.id}) }}" class="btn btn-sm btn-outline-secondary">Edytuj</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted">Nie znaleziono rekordów</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
