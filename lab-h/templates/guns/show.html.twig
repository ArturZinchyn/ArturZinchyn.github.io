{% extends 'base.html.twig' %}

{% block title %}Szczegóły broni{% endblock %}

{% block body %}
    <h1>Szczegóły broni</h1>

    <div class="card shadow-sm border-danger mb-4">
        <div class="card-body p-0">
            <table class="table table-borderless mb-0">
                <tbody>
                <tr><th class="w-25 ps-4 pt-3 text-danger">Id</th><td class="pt-3">{{ gun.id }}</td></tr>
                <tr><th class="ps-4 text-danger">Nazwa</th><td>{{ gun.name }}</td></tr>
                <tr><th class="ps-4 text-danger">Kaliber</th><td>{{ gun.caliber }}</td></tr>
                <tr><th class="ps-4 pb-3 text-danger">Pojemność magazynka</th><td class="pb-3">{{ gun.magazineCapacity }}</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ path('app_guns_index') }}" class="btn btn-secondary">Powrót do listy</a>
        <a href="{{ path('app_guns_edit', {'id': gun.id}) }}" class="btn btn-danger">Edytuj</a>
        {{ include('guns/_delete_form.html.twig') }}
    </div>
{% endblock %}
